<?xml version="1.0" encoding="UTF-8"?>
<!--
  SyncBridge CEP panel (Phase 1-C). Extension root = the after_effects folder of the repository,
  linked into %APPDATA%\Adobe\CEP\extensions\com.syncbridge.panel (see docs/PHASE1_PLAN.md V-P1C).
  Unsigned during development: needs PlayerDebugMode (set by the user, never by tools).
-->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.syncbridge" ExtensionBundleVersion="0.1.16"
                   ExtensionBundleName="SyncBridge" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.syncbridge.panel" Version="0.1.16"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[17.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.syncbridge.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./panel/index.html</MainPath>
          <ScriptPath>./jsx/syncbridge_cep_host.jsx</ScriptPath>
          <!-- Node.js for the About / update window (panel/js/about.js, D-46, H-AE-19): it runs the
               updater (SyncServer.exe update ...). Not mixed context: Node is reached through cep_node. -->
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>SyncBridge</Menu>
          <Geometry>
            <Size>
              <Height>680</Height>
              <Width>320</Width>
            </Size>
            <MinSize>
              <Height>300</Height>
              <Width>260</Width>
            </MinSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./panel/img/syncbridge_23.png</Icon>
            <Icon Type="RollOver">./panel/img/syncbridge_23.png</Icon>
            <Icon Type="DarkNormal">./panel/img/syncbridge_23.png</Icon>
            <Icon Type="DarkRollOver">./panel/img/syncbridge_23.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
