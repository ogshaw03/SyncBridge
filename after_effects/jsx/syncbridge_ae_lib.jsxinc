// SyncBridge: After Effects Time Remap helpers (ExtendScript / ES3).
//
// Verification status (docs/PHASE0_RESEARCH.md): the Property / Layer /
// CompItem methods used below are documented in the After Effects Scripting
// Guide, but this file has NOT yet been run on After Effects.
//   H-AE-1: keyTime / setValueAtTime / valueAtTime on Time Remap use comp time.
//   H-AE-2: Time Remap values are layer source time in seconds.
//   H-AE-3: ease speed/influence <-> Bezier handle (see src/syncbridge/core/ae_codec.py).
//   H-AE-4: removing keys / setting eases on Time Remap behaves like other 1D properties.
//   H-AE-5: keys can be placed at sub-frame times via setValueAtTime.

#include "syncbridge_json.jsxinc"

var SB = SB || {};

SB.SCHEMA = 'syncbridge.exchange';
SB.SCHEMA_VERSION = '0.1';
SB.TIME_EPS = 1e-6;

// ---------------------------------------------------------------- errors
// An error caused by the current state in AE (selection, settings, chosen file),
// not by a bug. It is shown as plain guidance, without a line number.
// `code` / `params` (optional) let the CEP panel show its own localized text
// (after_effects/panel/js/sbclient.js MESSAGES); `message` is the English fallback
// used by the Phase 0 scripts. JSX stays ASCII-only, so no Japanese text here.
SB.userError = function (message, code, params) {
    var e = new Error(message);
    e.sbUser = true;
    e.sbCode = code || null;
    e.sbParams = params || null;
    return e;
};

SB.alertError = function (title, e) {
    if (e && e.sbUser) {
        alert(e.message, title);
        return;
    }
    alert(title + ' error:\n' + e.toString() + (e.line ? '\n(line ' + e.line + ')' : ''));
};

SB.WRITE_PREF_HINT = 'If AE blocks file access, enable Preferences > Scripting & Expressions > ' +
    '"Allow Scripts to Write Files and Access Network".';

// ---------------------------------------------------------------- envelope
SB.uuid = function () {
    var s = '', i, hex = '0123456789abcdef';
    for (i = 0; i < 32; i++) {
        s += hex.charAt(Math.floor(Math.random() * 16));
        if (i === 7 || i === 11 || i === 15 || i === 19) { s += '-'; }
    }
    return s;
};

SB.isoNow = function () {
    function p(n) { return (n < 10 ? '0' : '') + n; }
    var d = new Date();
    return d.getUTCFullYear() + '-' + p(d.getUTCMonth() + 1) + '-' + p(d.getUTCDate()) + 'T' +
        p(d.getUTCHours()) + ':' + p(d.getUTCMinutes()) + ':' + p(d.getUTCSeconds()) + '+00:00';
};

SB.makeEnvelope = function (kind, data) {
    return {
        schema: SB.SCHEMA, schema_version: SB.SCHEMA_VERSION, kind: kind,
        event_id: SB.uuid(), source_id: 'ae', revision: 0, created: SB.isoNow(),
        app: { name: 'aftereffects', version: app.version, project: app.project.file ? app.project.file.fsName : null },
        data: data
    };
};

SB.checkEnvelope = function (env, kind) {
    if (!env || env.schema !== SB.SCHEMA) { throw SB.userError('The selected file is not a SyncBridge exchange file.'); }
    if (String(env.schema_version).split('.')[0] !== SB.SCHEMA_VERSION.split('.')[0]) {
        throw SB.userError('Unsupported schema_version ' + env.schema_version + ' (update SyncBridge).');
    }
    if (kind && env.kind !== kind) {
        throw SB.userError('Wrong file: expected a "' + kind + '" file, but this is "' + env.kind + '".');
    }
    return env.data;
};

// ---------------------------------------------------------------- files
SB.readJSON = function (file) {
    file.encoding = 'UTF-8';
    if (!file.exists) { throw SB.userError('File not found:\n' + file.fsName); }
    if (!file.open('r')) { throw SB.userError('Cannot open ' + file.fsName + '\n\n' + SB.WRITE_PREF_HINT); }
    var text = file.read();
    file.close();
    return SBJSON.parse(text);
};

SB.writeJSON = function (file, obj) {
    var folder = file.parent;
    if (folder && !folder.exists) { folder.create(); }
    file.encoding = 'UTF-8';
    if (!file.open('w')) { throw SB.userError('Cannot write ' + file.fsName + '\n\n' + SB.WRITE_PREF_HINT); }
    file.write(SBJSON.stringify(obj, '  '));
    file.close();
};

// Working folder for exchange files: <repo>/probe_results (ignored by git).
SB.workFolder = function () {
    var f = new Folder(new File($.fileName).parent.parent.parent.fsName + '/probe_results');
    if (!f.exists) { f.create(); }
    return f;
};

// JSON files in the work folder, newest first. `include` / `exclude` are RegExps on the name.
SB.listWorkFiles = function (include, exclude) {
    var files = SB.workFolder().getFiles('*.json'), out = [], i, f, name;
    for (i = 0; i < files.length; i++) {
        f = files[i];
        name = f.displayName;
        if (f instanceof File && (!include || include.test(name)) && !(exclude && exclude.test(name))) {
            out.push(f);
        }
    }
    out.sort(function (a, b) { return b.modified.getTime() - a.modified.getTime(); });
    return out;
};

// Pick one of `files` (newest first) from a list, or browse elsewhere. Returns a File or null.
// Does not rely on the OS file dialog's start folder, which Windows may ignore.
SB.pickFile = function (title, files) {
    var dlg, list, row, okBtn, browseBtn, names = [], i, choice = null;
    if (!files.length) {
        alert('No matching JSON file in\n' + SB.workFolder().fsName + '\n\nPick the file in the next dialog.', title);
        return File.openDialog(title, 'JSON:*.json');
    }
    for (i = 0; i < files.length; i++) { names.push(files[i].displayName); }
    dlg = new Window('dialog', title);
    dlg.alignChildren = 'fill';
    dlg.add('statictext', undefined, 'Folder: ' + SB.workFolder().fsName);
    list = dlg.add('dropdownlist', undefined, names);
    list.selection = 0;
    row = dlg.add('group');
    okBtn = row.add('button', undefined, 'OK');
    browseBtn = row.add('button', undefined, 'Browse...');
    row.add('button', undefined, 'Cancel', { name: 'cancel' });
    okBtn.onClick = function () { choice = files[list.selection.index]; dlg.close(); };
    browseBtn.onClick = function () { choice = 'browse'; dlg.close(); };
    dlg.show();
    if (choice === 'browse') { return File.openDialog(title, 'JSON:*.json'); }
    return choice;
};

// Ask for a file name and return a File in the work folder (null if cancelled).
SB.askWorkFile = function (title, defaultName) {
    var name = prompt('File name (saved in ' + SB.workFolder().fsName + ')', defaultName, title), file;
    if (!name) { return null; }
    if (!/\.json$/i.test(name)) { name += '.json'; }
    file = new File(SB.workFolder().fsName + '/' + name);
    if (file.exists && !confirm('Overwrite ' + file.fsName + '?')) { return null; }
    return file;
};

SB.backupFolder = function () {
    return new Folder(Folder.userData.fsName + '/SyncBridge/backups');
};

// ---------------------------------------------------------------- selection
SB.activeCompAndLayer = function () {
    var comp = app.project.activeItem;
    if (!(comp instanceof CompItem)) {
        throw SB.userError('Open a composition (click its timeline), select one layer, then run SyncBridge again.',
            'no_comp');
    }
    if (comp.selectedLayers.length !== 1) {
        throw SB.userError('Select exactly one layer in comp "' + comp.name + '" (currently ' +
            comp.selectedLayers.length + ' selected), then run SyncBridge again.\n\n' +
            'Export: the layer must have Time Remap enabled.\n' +
            'For the Phase 0 probe, run probe_ae.jsx instead (no selection needed).',
            'select_one_layer', { comp: comp.name, count: comp.selectedLayers.length });
    }
    return { comp: comp, layer: comp.selectedLayers[0] };
};

SB.timeRemapProp = function (layer) {
    return layer.property('ADBE Time Remapping');
};

// ---------------------------------------------------------------- info
SB.compInfo = function (comp) {
    return {
        name: comp.name, id: comp.id, frameRate: comp.frameRate, frameDuration: comp.frameDuration,
        duration: comp.duration, displayStartTime: comp.displayStartTime,
        workAreaStart: comp.workAreaStart, workAreaDuration: comp.workAreaDuration,
        width: comp.width, height: comp.height, pixelAspect: comp.pixelAspect,
        time: comp.time
    };
};

SB.layerInfo = function (layer) {
    var src = layer.source, info = {
        name: layer.name, index: layer.index, startTime: layer.startTime,
        inPoint: layer.inPoint, outPoint: layer.outPoint, stretch: layer.stretch,
        canSetTimeRemapEnabled: layer.canSetTimeRemapEnabled,
        timeRemapEnabled: layer.timeRemapEnabled, source: null
    };
    if (src) {
        info.source = {
            name: src.name, duration: src.duration, frameRate: src.frameRate,
            isComp: (src instanceof CompItem)
        };
        if (src instanceof CompItem) { info.source.displayStartTime = src.displayStartTime; }
    }
    return info;
};

// ---------------------------------------------------------------- keys
SB.interpName = function (t) {
    if (t === KeyframeInterpolationType.HOLD) { return 'HOLD'; }
    if (t === KeyframeInterpolationType.BEZIER) { return 'BEZIER'; }
    return 'LINEAR';
};

SB.interpType = function (name) {
    if (name === 'HOLD') { return KeyframeInterpolationType.HOLD; }
    if (name === 'BEZIER') { return KeyframeInterpolationType.BEZIER; }
    return KeyframeInterpolationType.LINEAR;
};

SB.readKeys = function (prop) {
    var keys = [], i, ie, oe;
    for (i = 1; i <= prop.numKeys; i++) {
        ie = prop.keyInTemporalEase(i)[0];
        oe = prop.keyOutTemporalEase(i)[0];
        keys.push({
            time: prop.keyTime(i), value: prop.keyValue(i),
            inInterp: SB.interpName(prop.keyInInterpolationType(i)),
            outInterp: SB.interpName(prop.keyOutInterpolationType(i)),
            inEase: { speed: ie.speed, influence: ie.influence },
            outEase: { speed: oe.speed, influence: oe.influence },
            autoBezier: prop.keyTemporalAutoBezier(i),
            continuous: prop.keyTemporalContinuous(i)
        });
    }
    return keys;
};

// Replace all keys of `prop` with `keys` (AE-native format, see ae_codec.py).
// New keys are set before stale keys are removed so the property never
// loses all of its keys.
SB.applyKeys = function (prop, keys) {
    var i, j, idx, k, t, keep;
    for (i = 0; i < keys.length; i++) {
        prop.setValueAtTime(keys[i].time, keys[i].value);
    }
    for (i = prop.numKeys; i >= 1; i--) {
        t = prop.keyTime(i);
        keep = false;
        for (j = 0; j < keys.length; j++) {
            if (Math.abs(keys[j].time - t) < SB.TIME_EPS) { keep = true; break; }
        }
        if (!keep) { prop.removeKey(i); }
    }
    for (i = 0; i < keys.length; i++) {
        k = keys[i];
        idx = prop.nearestKeyIndex(k.time);
        prop.setTemporalContinuousAtKey(idx, false);
        prop.setTemporalAutoBezierAtKey(idx, false);
        // Ease first, interpolation type last: AE 26.5 turned LINEAR / HOLD keys
        // into BEZIER when setTemporalEaseAtKey was called after the type was set
        // (probe 2026-10-16, H-AE-11).
        prop.setTemporalEaseAtKey(idx,
            [new KeyframeEase(k.inEase.speed, k.inEase.influence)],
            [new KeyframeEase(k.outEase.speed, k.outEase.influence)]);
        prop.setInterpolationTypeAtKey(idx, SB.interpType(k.inInterp), SB.interpType(k.outInterp));
    }
};

// Evaluate the property with AE itself (ground truth for verification).
SB.sample = function (prop, t0, t1, frameDuration, oversample) {
    var times = [], values = [], step = frameDuration / oversample, n, i, t;
    n = Math.floor((t1 - t0) / step + 1e-9);
    for (i = 0; i <= n; i++) {
        t = t0 + i * step;
        times.push(t);
        values.push(prop.valueAtTime(t, false));
    }
    if (t1 - times[times.length - 1] > SB.TIME_EPS) {
        times.push(t1);
        values.push(prop.valueAtTime(t1, false));
    }
    return { times: times, values: values };
};

SB.keyRange = function (keys, layer) {
    if (keys.length) { return [keys[0].time, keys[keys.length - 1].time]; }
    return [layer.inPoint, layer.outPoint];
};

// Apply the data of an "ae.timeremap.apply" envelope to `layer` (SPEC 5 safety rules):
// confirmation, JSON backup, one undo group, then an export taken after applying.
// Returns {status: "applied"|"cancelled", backup: path|null, after: export envelope|null}.
// `origin` (optional) names the sender in the confirmation text.
SB.applyToLayer = function (comp, layer, data, origin) {
    var keys = data.keys, msg, stamp, backup = null, after;
    if (!layer.canSetTimeRemapEnabled) {
        throw SB.userError('Time Remap cannot be enabled on layer "' + layer.name + '" ' +
            '(use a footage or precomp layer).', 'cannot_remap', { layer: layer.name });
    }
    if (Math.abs(comp.frameRate - data.comp_fps[0] / data.comp_fps[1]) > 1e-3) {
        msg = 'Comp frame rate ' + comp.frameRate + ' differs from the payload (' +
            data.comp_fps[0] + '/' + data.comp_fps[1] + '). Continue?';
        if (!confirm(msg)) { return { status: 'cancelled', backup: null, after: null }; }
    }
    if (layer.stretch !== 100) {
        if (!confirm('Layer stretch is ' + layer.stretch + '% (SyncBridge assumes 100%). Continue?')) {
            return { status: 'cancelled', backup: null, after: null };
        }
    }
    msg = 'Replace Time Remap of layer "' + layer.name + '" with ' + keys.length +
        ' keys (' + data.mode + ' mode)' + (origin ? ' from ' + origin : '') + '?' +
        (layer.timeRemapEnabled ? '' : '\nTime Remap will be enabled.') +
        '\nA JSON backup is written first. One undo restores the previous keys.';
    if (!confirm(msg)) { return { status: 'cancelled', backup: null, after: null }; }

    stamp = SB.isoNow().replace(/[:\-]/g, '').replace('+0000', '');
    if (layer.timeRemapEnabled) {
        backup = new File(SB.backupFolder().fsName + '/timeremap_' + stamp + '.json');
        SB.writeJSON(backup, SB.buildExport(comp, layer, 4));
    }

    app.beginUndoGroup('SyncBridge apply Time Remap');
    try {
        if (!layer.timeRemapEnabled) { layer.timeRemapEnabled = true; }
        SB.applyKeys(SB.timeRemapProp(layer), keys);
    } finally {
        app.endUndoGroup();
    }
    after = SB.buildExport(comp, layer, 8);
    return { status: 'applied', backup: backup ? backup.fsName : null, after: after };
};

// Build the "ae.timeremap.export" envelope for a layer.
// allowDisabled: a layer that can use Time Remap but has it off is exported with
// keys [] and samples null. The server only needs the comp / layer settings of a
// Maya -> AE target, and applying enables Time Remap (V-P1C, 2026-10-16).
SB.buildExport = function (comp, layer, oversample, allowDisabled) {
    var prop, keys, range, samples = null;
    if (!layer.timeRemapEnabled) {
        if (allowDisabled && layer.canSetTimeRemapEnabled) {
            return SB.makeEnvelope('ae.timeremap.export', {
                comp: SB.compInfo(comp), layer: SB.layerInfo(layer), keys: [], samples: null
            });
        }
        if (!layer.canSetTimeRemapEnabled) {
            // e.g. solids, text, shape and camera layers have no source time to remap.
            throw SB.userError('Layer "' + layer.name + '" cannot use Time Remap ' +
                '(solid, text, shape, camera and light layers have no source time).\n' +
                'Select a footage or precomp layer, e.g. the Maya render sequence.\n\n' +
                'For the Phase 0 probe, run probe_ae.jsx instead (no selection needed).',
                'cannot_remap', { layer: layer.name });
        }
        throw SB.userError('Time Remap is not enabled on layer "' + layer.name + '".\n' +
            'Enable it (Layer > Time > Enable Time Remapping) before Export, or use Apply.',
            'remap_off', { layer: layer.name });
    }
    prop = SB.timeRemapProp(layer);
    keys = SB.readKeys(prop);
    range = SB.keyRange(keys, layer);
    samples = SB.sample(prop, range[0], range[1], comp.frameDuration, oversample || 4);
    return SB.makeEnvelope('ae.timeremap.export', {
        comp: SB.compInfo(comp), layer: SB.layerInfo(layer), keys: keys, samples: samples
    });
};
